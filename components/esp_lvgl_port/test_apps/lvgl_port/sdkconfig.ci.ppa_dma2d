# Compile-coverage config for out-of-tree PPA/DMA2D LVGL draw units (ESP32-P4).
# Restricted to esp32p4 via components/.build-test-rules.yml.

CONFIG_LV_DRAW_BUF_ALIGN=64

# Keep stock LVGL in-tree PPA draw unit off to avoid duplicate symbols.
# CONFIG_LV_USE_PPA is not set

CONFIG_ESP_LVGL_PORT_USE_PPA=y
CONFIG_ESP_LVGL_PORT_USE_PPA_TRANSFORM=y
CONFIG_ESP_LVGL_PORT_USE_PPA_LAYER=y
CONFIG_ESP_LVGL_PORT_USE_PPA_BORDER=y
CONFIG_ESP_LVGL_PORT_USE_PPA_MASK_RECT=y
CONFIG_ESP_LVGL_PORT_USE_PPA_TILE_COMPOSER=y
CONFIG_ESP_LVGL_PORT_PPA_TILE_SIZE=256
CONFIG_ESP_LVGL_PORT_PPA_TILE_POOL_SIZE=4
CONFIG_ESP_LVGL_PORT_USE_PPA_GRADIENT=y
CONFIG_ESP_LVGL_PORT_PPA_GRADIENT_STEPS=32
CONFIG_ESP_LVGL_PORT_USE_PPA_ROUND_FILL=y
CONFIG_ESP_LVGL_PORT_PPA_ROUND_FILL_MIN_RADIUS=1
CONFIG_ESP_LVGL_PORT_USE_PPA_ARC=y
CONFIG_ESP_LVGL_PORT_USE_PPA_LINE=y
CONFIG_ESP_LVGL_PORT_USE_PPA_TRIANGLE=y
CONFIG_ESP_LVGL_PORT_USE_PPA_RUNTIME_TUNING=y
CONFIG_ESP_LVGL_PORT_USE_PPA_STATS=y
CONFIG_ESP_LVGL_PORT_USE_PPA_ASYNC=y
CONFIG_ESP_LVGL_PORT_PPA_FILL_PENDING_TRANS=16
CONFIG_ESP_LVGL_PORT_PPA_BLEND_PENDING_TRANS=16
CONFIG_ESP_LVGL_PORT_PPA_SRM_PENDING_TRANS=16
# CONFIG_ESP_LVGL_PORT_USE_PPA_LABEL is not set
CONFIG_ESP_LVGL_PORT_USE_PPA_IMG=y
CONFIG_ESP_LVGL_PORT_PPA_BURST_LENGTH=128
CONFIG_ESP_LVGL_PORT_USE_ESP_DMA2D=y
CONFIG_ESP_LVGL_PORT_ESP_DMA2D_BURST_LENGTH=64
